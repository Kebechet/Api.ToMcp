<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <PropertyGroup>
    <ApiToMcpAutoCreateConfig Condition="'$(ApiToMcpAutoCreateConfig)' == ''">true</ApiToMcpAutoCreateConfig>
    <ApiToMcpConfigPath Condition="'$(ApiToMcpConfigPath)' == ''">$(MSBuildProjectDirectory)\Mcp\generator.json</ApiToMcpConfigPath>
    <ApiToMcpConfigDirectory>$([System.IO.Path]::GetDirectoryName('$(ApiToMcpConfigPath)'))</ApiToMcpConfigDirectory>
  </PropertyGroup>

  <Target Name="CreateMcpGeneratorConfig"
          BeforeTargets="CoreCompile"
          Condition="'$(ApiToMcpAutoCreateConfig)' == 'true' AND !Exists('$(ApiToMcpConfigPath)')">

    <PropertyGroup>
      <_McpConfigFullPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(ApiToMcpConfigPath)'))</_McpConfigFullPath>
      <_McpConfigSearchDirectory>$([System.IO.Path]::GetDirectoryName($([System.IO.Path]::GetDirectoryName('$(_McpConfigFullPath)'))))</_McpConfigSearchDirectory>
    </PropertyGroup>

    <!-- On a case-sensitive file system the config can sit at a path that differs only in case, such as mcp/ for the
         default Mcp/, and Exists() misses it. Conditions compare case-insensitively, so this finds it, if the difference
         is in the config's folder or file name. A starter written beside it would leave it unused, and the two then
         clash as duplicate Content items (NETSDK1022) on the next build.
         See https://github.com/Kebechet/Api.ToMcp/issues/17 -->
    <ItemGroup Condition="'$(_McpConfigSearchDirectory)' != ''">
      <_McpConfigCandidate Include="$(_McpConfigSearchDirectory)/*/*.json" />
      <_McpCaseVariantConfig Include="@(_McpConfigCandidate)"
                             Condition="'%(FullPath)' == '$(_McpConfigFullPath)'" />
    </ItemGroup>

    <Warning Code="MCP101"
             Condition="'@(_McpCaseVariantConfig)' != ''"
             Text="Api.ToMcp found no config at $(_McpConfigFullPath) but found @(_McpCaseVariantConfig->'%(FullPath)'), whose path differs only in letter case, so it uses that file and creates no starter config. Set ApiToMcpConfigPath to that file, or rename it to match, so that every file system finds it." />

    <MakeDir Directories="$(ApiToMcpConfigDirectory)"
             Condition="'@(_McpCaseVariantConfig)' == '' AND !Exists('$(ApiToMcpConfigDirectory)')" />

    <PropertyGroup>
      <_McpStarterConfig><![CDATA[{
  "schemaVersion": 1,
  "mode": "SelectedOnly",
  "include": [],
  "exclude": [],
  "naming": {
    "toolNameFormat": "{Controller}_{Action}",
    "removeControllerSuffix": true
  }
}]]></_McpStarterConfig>
    </PropertyGroup>

    <WriteLinesToFile File="$(ApiToMcpConfigPath)"
                      Lines="$(_McpStarterConfig)"
                      Overwrite="true"
                      Condition="'@(_McpCaseVariantConfig)' == ''" />

    <!-- A warning rather than a message: the starter config selects no action, so the app's MCP server lists no tools
         until its include is filled, and a message is missing from IDE error lists and most CI log views.
         See https://github.com/Kebechet/Api.ToMcp/issues/17 -->
    <Warning Code="MCP100"
             Condition="'@(_McpCaseVariantConfig)' == ''"
             Text="Api.ToMcp created a starter config at $(_McpConfigFullPath), as none existed there. It is in SelectedOnly mode with an empty include list, so no MCP tools are generated until you list controllers or actions in its include. If your config is at another path, set ApiToMcpConfigPath to it and delete this file." />

  </Target>

  <!-- Auto-add to AdditionalFiles if not already present -->
  <Target Name="EnsureMcpConfigInAdditionalFiles"
          BeforeTargets="CoreCompile"
          AfterTargets="CreateMcpGeneratorConfig"
          Condition="Exists('$(ApiToMcpConfigPath)') OR '@(_McpCaseVariantConfig)' != ''">

    <ItemGroup>
      <_ExistingMcpConfig Include="@(AdditionalFiles)"
                          Condition="$([System.String]::new('%(Identity)').EndsWith('generator.json'))" />
    </ItemGroup>

    <ItemGroup Condition="'@(_ExistingMcpConfig)' == ''">
      <AdditionalFiles Include="$(ApiToMcpConfigPath)" Condition="Exists('$(ApiToMcpConfigPath)')" />
      <AdditionalFiles Include="@(_McpCaseVariantConfig)" />
    </ItemGroup>

  </Target>

</Project>
